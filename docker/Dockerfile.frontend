# Build from repo root:
#   docker build -f docker/Dockerfile.frontend -t erp/frontend:latest .
FROM node:20-alpine AS builder
WORKDIR /app
RUN npm install -g pnpm@10
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/frontend ./apps/frontend
# Minimal workspace install for frontend package
RUN pnpm install --no-frozen-lockfile --filter @erp/frontend...
ENV NEXT_TELEMETRY_DISABLED=1
# Build-time rewrite target for server-side /api proxy (compose: http://api-gateway:4005)
ARG GATEWAY_INTERNAL_URL=http://api-gateway:4005
ENV GATEWAY_INTERNAL_URL=$GATEWAY_INTERNAL_URL
RUN pnpm --filter @erp/frontend run build

FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/frontend ./apps/frontend
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
WORKDIR /app/apps/frontend
EXPOSE 3000
CMD ["pnpm", "exec", "next", "start", "-H", "0.0.0.0", "-p", "3000"]
