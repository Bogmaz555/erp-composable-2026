{
  "name": "@erp/temporal-worker",
  "version": "0.3.0",
  "private": true,
  "description": "Enterprise Q2 Temporal workflows (ETO compensation, KSeF/revenue) with G-lite fallback",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/worker.ts",
    "start:prod": "node dist/worker.js",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@temporalio/client": "^1.20.3",
    "@temporalio/worker": "^1.20.3",
    "@temporalio/workflow": "^1.20.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "tsx": "^4.23.1",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": { "^.+\\.(t|j)s$": "ts-jest" },
    "testEnvironment": "node"
  }
}
