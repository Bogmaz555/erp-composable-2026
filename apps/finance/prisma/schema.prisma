generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/client-finance"
}

datasource db {
  provider = "postgresql"
  url      = env("FINANCE_DATABASE_URL")
}

model Account {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  type        AccountType
  balance     Decimal    @default(0.0)
  currency    String   @default("PLN")
  entries     JournalEntry[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model JournalEntry {
  id          String   @id @default(uuid())
  tenantId    String   @default("default")
  accountId   String
  amount      Decimal
  type        EntryType
  referenceId String?  // ID of the source event (e.g., invoice ID, PO ID, WO ID)
  source      String?  // The source module (e.g., 'PROCUREMENT', 'SALES', 'MANUFACTURING_WIP')
  description String?
  account     Account  @relation(fields: [accountId], references: [id])
  createdAt   DateTime @default(now())
  @@index([tenantId, referenceId])
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum EntryType {
  DEBIT
  CREDIT
}

// Universal Journal lite — płaska księga mikrokosztów (bez rewolucji GL)
model UniversalJournalEntry {
  id           String   @id @default(uuid())
  tenantId     String   @default("default")
  projectId    String?
  wbsElementId String?
  eventType    String
  sourceModule String
  amount       Decimal
  currency     String   @default("PLN")
  referenceId  String?
  description  String?
  bookedAt     DateTime @default(now())
  @@index([tenantId, projectId, bookedAt])
  @@index([eventType])
}

// ETO / Project Manufacturing WIP & Costing (Faza 1 alignment)
model ProjectCost {
  id          String   @id @default(uuid())
  tenantId    String   @default("default")
  projectId   String
  workOrderId String?
  costType    String   // MATERIAL | LABOR | OVERHEAD | SUBCONTRACT
  amount      Decimal
  currency    String   @default("PLN")
  reference   String?
  bookedAt    DateTime @default(now())
  @@index([tenantId, projectId, costType])
  @@index([workOrderId])
}

model WipAccount {
  id          String   @id @default(uuid())
  tenantId    String   @default("default")
  projectId   String   @unique
  wipBalance  Decimal    @default(0)
  materialReserved Decimal @default(0)  // from INV reservations
  laborCost   Decimal    @default(0)
  updatedAt   DateTime @updatedAt
}

model MilestoneBilling {
  id          String   @id @default(uuid())
  tenantId    String   @default("default")
  projectId   String
  milestone   String   // e.g. FAT, SAT, SHIPMENT, FINAL
  amount      Decimal
  percent     Decimal?
  status      String   @default("PENDING") // PENDING | READY | INVOICED | PAID
  dueDate     DateTime?
  invoicedAt    DateTime?
  reachedAt     DateTime?
  recognizedAt  DateTime?
  @@index([tenantId, projectId, status])
  @@unique([tenantId, projectId, milestone])
}

model Payable {
  id        String    @id @default(uuid())
  tenantId  String    @default("default")
  vendor    String
  amount    Decimal
  currency  String    @default("PLN")
  dueDate   DateTime?
  status    String    @default("PENDING") // PENDING | PAID | OVERDUE
  orderRef  String?
  createdAt DateTime  @default(now())
  @@index([tenantId, status])
}

model Receivable {
  id         String    @id @default(uuid())
  tenantId   String    @default("default")
  client     String
  amount     Decimal
  currency   String    @default("PLN")
  dueDate    DateTime?
  status     String    @default("PENDING")
  invoiceRef String?
  projectId  String?
  createdAt  DateTime  @default(now())
  @@index([tenantId, status])
}

model RevenueRecognition {
  id                  String   @id @default(uuid())
  tenantId            String   @default("default")
  projectId           String
  milestone           String
  amount              Decimal
  currency            String   @default("PLN")
  ksefReferenceNumber String?
  recognizedAt        DateTime @default(now())
  @@index([tenantId, projectId])
}

// Project/operation cost rates (Faza 2 — replaces env-only defaults)
model CostRate {
  id           String   @id @default(uuid())
  tenantId     String   @default("default")
  projectId    String?
  costType     String   // LABOR | OVERHEAD | MATERIAL
  rateValue    Decimal
  unit         String   @default("HOUR") // HOUR | PCT | PLN_PER_UNIT
  effectiveFrom DateTime @default(now())
  effectiveTo   DateTime?
  @@index([tenantId, projectId, costType])
}

// Środki trwałe — amortyzacja liniowa (enterprise FA)
model FixedAsset {
  id                     String   @id @default(uuid())
  tenantId               String   @default("default")
  code                   String   @unique
  name                   String
  category               String   @default("MACHINERY") // MACHINERY | VEHICLE | IT | BUILDING
  acquisitionCost        Decimal
  salvageValue           Decimal    @default(0)
  usefulLifeMonths       Int      @default(60)
  depreciationMethod     String   @default("STRAIGHT_LINE")
  accumulatedDepreciation Decimal   @default(0)
  netBookValue           Decimal
  status                 String   @default("ACTIVE") // ACTIVE | DISPOSED | FULLY_DEPRECIATED
  acquiredAt             DateTime @default(now())
  lastDepreciationAt     DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  depreciations          FixedAssetDepreciation[]
  @@index([tenantId, status, category])
}

model FixedAssetDepreciation {
  id           String     @id @default(uuid())
  tenantId     String     @default("default")
  assetId      String
  asset        FixedAsset @relation(fields: [assetId], references: [id])
  period       String     // YYYY-MM
  amount       Decimal
  netBookAfter Decimal
  postedAt     DateTime   @default(now())
  @@index([tenantId, assetId, period])
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model OutboxEvent {
  id            String       @id @default(uuid())
  tenantId      String       @default("default")
  aggregateId   String
  aggregateType String
  eventType     String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?
  createdAt     DateTime     @default(now())
  lockedAt      DateTime?
  lockedBy      String?
  processedAt   DateTime?
  @@index([tenantId, status, createdAt])
}

/// Consumer idempotency ledger (Enterprise Q0 / E0.3).
model ProcessedEvent {
  eventId     String
  consumer    String
  processedAt DateTime @default(now())

  @@id([eventId, consumer])
  @@index([consumer, processedAt])
}

// ── Enterprise Q2: accounting period close (KD-Q2-1) ─────────────────────────
/// Fiscal month per tenant (periodKey = YYYY-MM). Postings refuse CLOSED.
model AccountingPeriod {
  id          String   @id @default(uuid())
  tenantId    String   @default("default")
  /// Calendar period key YYYY-MM
  periodKey   String
  status      String   @default("OPEN") // OPEN | CLOSING | CLOSED
  openedAt    DateTime @default(now())
  closedAt    DateTime?
  closedBy    String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, periodKey])
  @@index([tenantId, status])
}

// ── Enterprise Q2: AR/AP skeleton linked to journal ───────────────────────────
/// Accounts Receivable invoice (ETO billing path — not full AR suite).
model ArInvoice {
  id             String    @id @default(uuid())
  tenantId       String    @default("default")
  client         String
  projectId      String?
  amount         Decimal
  currency       String    @default("PLN")
  status         String    @default("OPEN") // OPEN | DRAFT | POSTED | PAID | VOID
  milestone      String?
  ksefReference  String?
  journalEntryId String?
  receivableId   String?
  correlationId  String?
  invoiceRef     String?
  description    String?
  dueDate        DateTime?
  postedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId, status, projectId])
  @@index([correlationId])
  @@index([journalEntryId])
}

/// Accounts Payable bill (procurement commitment path — not full AP suite).
model ApBill {
  id             String    @id @default(uuid())
  tenantId       String    @default("default")
  vendor         String
  orderRef       String?
  amount         Decimal
  currency       String    @default("PLN")
  status         String    @default("OPEN") // OPEN | DRAFT | POSTED | PAID | VOID
  journalEntryId String?
  payableId      String?
  correlationId  String?
  description    String?
  dueDate        DateTime?
  postedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId, status])
  @@index([orderRef])
  @@index([correlationId])
  @@index([journalEntryId])
}
