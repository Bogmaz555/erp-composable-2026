# ERP 2026 — global runtime profile (copy to .env.erp / merge into .env)
# ERP_AUTH_ENFORCE=true  → boot:smart / boot:prod:smart use boot:all:auth
ERP_AUTH_ENFORCE=false

# --- Pilot / security (PR1) — no secrets committed; fill locally ---
# PM service fail-fast: required (pilot/prod). Local may use DATABASE_URL only as last resort.
# PM_DATABASE_URL=postgresql://erp_user:CHANGE_ME@localhost:5434/pm_db?schema=public
#
# Meilisearch master key (gateway + search-service + compose --profile search).
# Required when NODE_ENV=production, AUTH_ENFORCE=true, PILOT=1, or MEILI_REQUIRED=true.
# MEILI_MASTER_KEY=
# MEILI_URL=http://127.0.0.1:7700
# MEILI_HOST=http://localhost:7700
# MEILI_REQUIRED=false

# --- Pilot auth (PR2) ---
# Secure-by-default on gateway: ON unless AUTH_DISABLE=true or AUTH_ENFORCE=false.
# PILOT=1 forbids AUTH_ENFORCE=false / AUTH_DISABLE=true and requires USE_KEYCLOAK_JWKS=true.
# PILOT=1
# AUTH_ENFORCE=true
# USE_KEYCLOAK_JWKS=true
# KEYCLOAK_JWKS_URI=http://localhost:8080/realms/erp/protocol/openid-connect/certs
# JWT_SECRET=  # local non-pilot HS256 only

# --- Deploy pure-proxy (PR17) ---
# Gateway listen (container-safe defaults: HOST=0.0.0.0 PORT=4005)
# HOST=0.0.0.0
# PORT=4005
# Domain upstreams (origin only, no path). Defaults are loopback for local dev.
# CRM_SERVICE_URL=http://127.0.0.1:4001
# PM_SERVICE_URL=http://127.0.0.1:4002
# INV_SERVICE_URL=http://127.0.0.1:4003
# PROC_SERVICE_URL=http://127.0.0.1:4004
# MES_SERVICE_URL=http://127.0.0.1:4006
# PLM_SERVICE_URL=http://127.0.0.1:4007
# QUALITY_SERVICE_URL=http://127.0.0.1:4008
# EAM_SERVICE_URL=http://127.0.0.1:4009
# FIN_SERVICE_URL=http://127.0.0.1:4010
# ANALYTICS_SERVICE_URL=http://127.0.0.1:4011
# HR_SERVICE_URL=http://127.0.0.1:4012
# TAX_SERVICE_URL=http://127.0.0.1:4015
# SEARCH_SERVICE_URL=http://127.0.0.1:4018
# APPROVALS_SERVICE_URL=http://127.0.0.1:4019
# Compose example: PM_SERVICE_URL=http://pm-service:4002
