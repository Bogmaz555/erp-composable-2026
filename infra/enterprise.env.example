# Enterprise 0.1 platform profile (Q0) — copy into compose / k8s env, never commit secrets.
# Design: docs/ENTERPRISE-0.1-PLATFORM-DESIGN.md (KD-1 JetStream mandatory)

# --- Profile selection (either is enough) ---
ENTERPRISE=1
# ERP_PROFILE=enterprise

# --- Messaging (mandatory under enterprise; boot fails if off) ---
NATS_JETSTREAM=true
NATS_URL=nats://127.0.0.1:4222

# --- Auth (enterprise hard path extended in later PRs; pilot already forbids bypass) ---
# AUTH_ENFORCE=true
# AUTH_DISABLE must not be true
# KEYCLOAK_ISSUER=http://127.0.0.1:8080/realms/erp
# JWT_AUDIENCE=erp-api
# JWT_AZP_ALLOWLIST=erp-frontend,erp-gateway

# --- Tenancy (DEDICATED_STACK — ADR-009) ---
# TENANCY_MODEL=DEDICATED_STACK
# ERP_TENANT_ID=default

# --- Outbox relay (multi-replica reclaim uses lockedAt after PR2/PR3) ---
# OUTBOX_RECLAIM_MINUTES=15
# OUTBOX_MAX_ATTEMPTS=5
# OUTBOX_BATCH_SIZE=50

# Local pilot (core NATS) — leave ENTERPRISE unset and NATS_JETSTREAM off/opt-in.
