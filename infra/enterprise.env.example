# Enterprise profiles — copy to .env.staging / .env.prod (gitignored). NEVER commit real secrets.
# Contract: docs/enterprise-2.1/SECRETS-CONTRACT.md
# Design: docs/ENTERPRISE-2.1-P0-BOOTSTRAP-DESIGN.md

# =============================================================================
# Profile selection
# =============================================================================
# local-pilot: leave ENTERPRISE unset; NATS_JETSTREAM optional
# staging/prod: set both
ENTERPRISE=1
# ERP_PROFILE=enterprise

# =============================================================================
# Messaging (mandatory under ENTERPRISE — gateway asserts at boot)
# =============================================================================
NATS_JETSTREAM=true
NATS_URL=nats://127.0.0.1:4222

# =============================================================================
# Auth
# =============================================================================
AUTH_ENFORCE=true
# AUTH_DISABLE must NOT be true
USE_KEYCLOAK_JWKS=true
KEYCLOAK_ISSUER=http://127.0.0.1:8080/realms/erp
KEYCLOAK_JWKS_URI=http://127.0.0.1:8080/realms/erp/protocol/openid-connect/certs
# JWT_AUDIENCE=erp-api
# JWT_AZP_ALLOWLIST=erp-frontend,erp-gateway

# =============================================================================
# Tenancy (DEDICATED_STACK — ADR-009)
# =============================================================================
TENANCY_MODEL=DEDICATED_STACK
ERP_TENANT_ID=default
DEFAULT_TENANT_ID=default

# =============================================================================
# Host / bind
# =============================================================================
HOST=0.0.0.0

# =============================================================================
# Databases (examples — replace for staging/prod)
# =============================================================================
# PM_DATABASE_URL=postgresql://USER:PASS@host:5434/pm_db
# INV_DATABASE_URL=postgresql://USER:PASS@host:5436/inv_db
# PROC_DATABASE_URL=postgresql://USER:PASS@host:5437/proc_db
# FINANCE_DATABASE_URL=postgresql://USER:PASS@host:5438/fin_db
# ANALYTICS_DATABASE_URL=postgresql://USER:PASS@host:5445/analytics_db
# DMS_DATABASE_URL=postgresql://USER:PASS@host:54xx/dms_db

# =============================================================================
# Meili (optional but required if search enabled under AUTH)
# =============================================================================
# MEILI_MASTER_KEY=
# MEILI_HOST=http://127.0.0.1:7700

# =============================================================================
# Outbox
# =============================================================================
# OUTBOX_RECLAIM_MINUTES=15
# OUTBOX_MAX_ATTEMPTS=5
# OUTBOX_BATCH_SIZE=50

# =============================================================================
# Webhooks (P4+)
# =============================================================================
# WEBHOOK_SIGNING_SECRET=

# =============================================================================
# Analytics NATS (pilot: often disable dual Nest path)
# =============================================================================
# ANALYTICS_NATS_DISABLE=true
